---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ProjectRow from '../../components/ProjectRow.astro';
import { currentProjects } from '../../data/projects';

const groups = (['Research', 'Engineering', 'Applied AI'] as const)
  .map((category) => ({ category, items: currentProjects.filter((project) => project.category === category) }))
  .filter((group) => group.items.length > 0);
---
<BaseLayout
  title="Projects"
  description="Research, engineering, and applied AI projects by Muheng Li — AI accelerators, LLM serving, GPU kernels, FPGA design, and agent systems."
>
  <section class="block">
    <h2 class="section">Projects</h2>
    <p>
      A selection of research directions, engineering projects, and applied AI work.
    </p>
  </section>

  {groups.map((group) => (
    <section class="block">
      <h2 class="section">{group.category}</h2>
      <div class="proj-list">{group.items.map((project) => <ProjectRow project={project} />)}</div>
    </section>
  ))}
</BaseLayout>
