---
import BaseLayout from '../layouts/BaseLayout.astro';
import ProjectRow from '../components/ProjectRow.astro';
import { projects } from '../data/projects';
import { getCollection } from 'astro:content';

const featured = projects.filter((project) => project.featured);
const posts = (await getCollection('blog', ({ data }) => !data.draft))
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime())
  .slice(0, 3);
const formatDate = (date: Date) =>
  date.toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric', timeZone: 'UTC' });
---
<BaseLayout>
  <section class="block">
    <h2 class="section">About Me</h2>
    <p>
      I am a senior undergraduate in the <a href="https://iiis.tsinghua.edu.cn/en/" target="_blank" rel="noopener noreferrer">Yao Class</a>
      (Institute for Interdisciplinary Information Sciences) at
      <a href="https://www.tsinghua.edu.cn/en/" target="_blank" rel="noopener noreferrer">Tsinghua University</a>,
      pursuing a B.S. in Computer Science and Technology (2023–2027, expected).
    </p>
    <p>
      My research sits at the intersection of AI systems and computer architecture. I study the mechanisms that determine
      how efficiently large models run — from accelerator and memory architecture (e.g., 3D&nbsp;DRAM-based designs for
      language models), to LLM inference and serving (speculative decoding and draft-model design), to GPU kernel
      execution (persistent kernels).
    </p>
    <p>
      Currently, I am a research intern at the Catalyst Lab, Carnegie Mellon University, working on persistent GPU
      kernels, and a research intern at Tencent, working on draft-model architectures for speculative decoding.
      Previously, I worked on LLM accelerator architecture at ArchipLab, Tsinghua University, and on search-based
      reasoning for Olympiad-style mathematics and physics problems at Tencent.
    </p>
  </section>

  <section class="block">
    <h2 class="section">Research Interests</h2>
    <ul>
      <li><strong>AI accelerator architecture</strong> — memory-centric accelerator design for large language models, including 3D DRAM-based architectures.</li>
      <li><strong>LLM inference &amp; serving systems</strong> — speculative decoding, draft-model architectures, and serving efficiency.</li>
      <li><strong>GPU systems &amp; kernel execution</strong> — persistent kernels and system-level execution for GPU workloads.</li>
      <li><strong>Agent systems &amp; empirical LLM theory</strong> — tool-using agent workflows and measurement-driven studies of model behavior.</li>
    </ul>
  </section>

  <section class="block">
    <h2 class="section">Education</h2>
    <ul>
      <li>
        <strong>B.S. in Computer Science and Technology</strong>, Tsinghua University, 2023–2027 (expected).
        Institute for Interdisciplinary Information Sciences (Yao Class). GPA 3.8 / 4.0.
      </li>
    </ul>
  </section>

  <section class="block">
    <h2 class="section">Selected Projects</h2>
    <div class="proj-list">{featured.map((project) => <ProjectRow project={project} />)}</div>
    <p style="margin-top:14px"><a href="/projects/">All projects →</a></p>
  </section>

  <section class="block">
    <h2 class="section">Experience</h2>
    <h3>Academic</h3>
    <ul class="exp">
      <li><span class="exp-when">Apr 2026 – Present</span><span><strong>Catalyst Lab, Carnegie Mellon University</strong> — Research Intern. Persistent GPU kernels and system-level execution.</span></li>
      <li><span class="exp-when">Jan 2025 – Present</span><span><strong>ArchipLab, Tsinghua University</strong> — Research Assistant. LLM accelerator architecture with 3D DRAM.</span></li>
    </ul>
    <h3>Industry</h3>
    <ul class="exp">
      <li><span class="exp-when">Jan 2026 – Present</span><span><strong>Tencent (WeChat Group)</strong> — Research Intern. Draft-model architecture for speculative decoding.</span></li>
      <li><span class="exp-when">Sep 2024 – Feb 2025</span><span><strong>ZhenFund</strong> — Investment Research Intern.</span></li>
      <li><span class="exp-when">Jul – Sep 2024</span><span><strong>Tencent (Machine Learning Platform)</strong> — Research Intern. MCTS-based reasoning for Olympiad-style tasks.</span></li>
    </ul>
  </section>

  <section class="block">
    <h2 class="section">Blog</h2>
    {posts.length > 0 ? (
      <ul class="post-list">
        {posts.map((post) => (
          <li>
            <span class="post-when"><time datetime={post.data.date.toISOString()}>{formatDate(post.data.date)}</time></span>
            <span>
              <div class="post-title"><a href={`/blog/${post.id}/`}>{post.data.title}</a></div>
              <p class="post-summary">{post.data.summary}</p>
            </span>
          </li>
        ))}
      </ul>
    ) : (
      <p class="note">Posts will appear here as they are published.</p>
    )}
    <p style="margin-top:14px"><a href="/blog/">All posts →</a></p>
  </section>

  <section class="block">
    <h2 class="section">Miscs</h2>
    <ul>
      <li>Board member of CPHOS, a nonprofit community of physics-competition alumni that organizes free competitions and academic seminars for high-school students (2023 – present).</li>
    </ul>
  </section>
</BaseLayout>
