---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
const notes = (await getCollection('notes', ({data}) => !data.draft)).sort((a,b) => b.data.date.getTime() - a.data.date.getTime());
const format = (date: Date) => date.toLocaleDateString('en-US',{month:'short',day:'numeric',year:'numeric',timeZone:'UTC'});
---
<BaseLayout title="Notes" description="Technical notes on efficient LLM inference, AI architecture, and systems.">
<div class="container"><section class="page-intro"><div class="tiny-label">KNOWLEDGE / 04</div><h1>Small notes, <em>clear thinking.</em></h1><p>Working notes and technical explanations. These are for learning and discussion, not claims about unpublished research results.</p></section>
<section class="page-section"><p class="list-intro">NOTES / {notes.length} ENTRIES</p><div class="article-list">{notes.map(note => <a href={`/notes/${note.id}/`}><time datetime={note.data.date.toISOString()}>{format(note.data.date)}</time><div><h2>{note.data.title}</h2><p>{note.data.summary}</p><div class="article-tags">{note.data.tags.join(' · ')}</div></div><span class="arrow">↗</span></a>)}</div>{notes.length === 0 && <p>Notes will appear here as they are published.</p>}</section></div>
</BaseLayout>
