---
import type { Project } from '../data/projects';
const { project, index = 0 } = Astro.props as { project: Project; index?: number };
---
<a class="project-card" href={`/projects/${project.slug}/`}>
  <div class="project-topline"><span class="project-number">{String(index + 1).padStart(2,'0')} / {project.category}</span><span class="project-arrow" aria-hidden="true">↗</span></div>
  <h3>{project.title}</h3>
  <p>{project.tagline}</p>
  <div class="chip-row">{project.tags.slice(0, 3).map(tag => <span class="chip">{tag}</span>)}</div>
  <div class="project-card-foot"><span>{project.affiliation}</span><span>{project.period}</span></div>
</a>
