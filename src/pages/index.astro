---
import BaseLayout from '../layouts/BaseLayout.astro';
import ProjectRow from '../components/ProjectRow.astro';
import { projects } from '../data/projects';
import { getCollection } from 'astro:content';

const featured = projects.filter((project) => project.featured);
const posts = (await getCollection('blog', ({ data }) => !data.draft))
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime())
  .slice(0, 3);
const formatDate = (date: Date) =>
  date.toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric', timeZone: 'UTC' });
---
<BaseLayout>
  <section class="block">
    <h2 class="section">About Me</h2>
    <p>
      I am a senior undergraduate in the <a href="https://iiis.tsinghua.edu.cn/en/" target="_blank" rel="noopener noreferrer">Yao Class</a>
      (Institute for Interdisciplinary Information Sciences) at
      <a href="https://www.tsinghua.edu.cn/en/" target="_blank" rel="noopener noreferrer">Tsinghua University</a>,
      pursuing a B.S. in Computer Science and Technology, and an incoming PhD student at <a href="https://www.tsinghua.edu.cn/en/" target="_blank" rel="noopener noreferrer">ARCH-Lab</a>.
    </p>
    <p>
      My research sits at the intersection of AI systems and computer architecture. I work on the mechanisms that
      determine how efficiently large models run — from chip architecture (3D-stacked accelerators, on-chip networks) and
      kernel optimization (megakernel generation, persistent kernels), to inference-system design (speculative decoding
      and draft models) and agent systems that plan and run long-horizon research workflows.
    </p>
    <p>
      I have spent time as a research intern at the <a href="https://catalyst.cs.cmu.edu/" target="_blank" rel="noopener noreferrer">Catalyst Lab</a>,
      Carnegie Mellon University, on persistent GPU kernels and megakernel generation, at
      <a href="https://www.tencent.com/en-us/" target="_blank" rel="noopener noreferrer">Tencent</a>
      on draft models for speculative decoding and on search-based reasoning for Olympiad-style mathematics and physics,
      and at ARCH-Lab, Tsinghua University, on 3D-stacked accelerator design.
    </p>
  </section>

  <section class="block">
    <h2 class="section">Research Interests</h2>
    <ul>
      <li><strong>Chip architecture</strong> — accelerator and memory architecture for AI: 3D-stacked designs, on-chip network topologies, and power, performance, and area analysis for tiled accelerators.</li>
      <li><strong>Kernel optimization &amp; megakernel generation</strong> — fusing an entire inference pipeline into a single persistent kernel, through boundary fusion, joint retuning, and automated compile–benchmark–revise loops.</li>
      <li><strong>Compiler generation &amp; inference-system design</strong> — compilers and runtimes that turn model programs into efficient kernels, and serving systems for LLM inference such as speculative decoding.</li>
      <li><strong>Agent systems for research</strong> — long-horizon control of concurrent workflows that plan, execute experiments, and build reusable skills, toward agentic hardware–software co-design.</li>
    </ul>
  </section>

  <section class="block">
    <h2 class="section">Education</h2>
    <ul>
      <li>
        <strong>B.S. in Computer Science and Technology</strong>, Tsinghua University, 2023–2027 (expected).
        Institute for Interdisciplinary Information Sciences (Yao Class). GPA 3.8 / 4.0.
      </li>
    </ul>
  </section>

  <section class="block">
    <h2 class="section">Selected Projects</h2>
    <div class="proj-list">{featured.map((project) => <ProjectRow project={project} />)}</div>
    <p style="margin-top:14px"><a href="/projects/">All projects →</a></p>
  </section>

  <section class="block">
    <h2 class="section">Experience</h2>
    <h3>Academic</h3>
    <ul class="exp">
      <li><span class="exp-when">Feb 2026 – Jul 2026</span><span><strong>Catalyst Lab, Carnegie Mellon University</strong> — Research Intern. Persistent GPU kernels and megakernel generation.</span></li>
      <li><span class="exp-when">Feb 2025 – Present</span><span><strong>ARCH-Lab, Tsinghua University</strong> — Research Assistant. 3D-stacked accelerator design for large language models.</span></li>
    </ul>
    <h3>Industry</h3>
    <ul class="exp">
      <li><span class="exp-when">Jan 2026 – Present</span><span><strong>Tencent (WeChat Group)</strong> — Research Intern. Draft-model architecture for speculative decoding.</span></li>
      <li><span class="exp-when">Sep 2024 – Feb 2025</span><span><strong>ZhenFund</strong> — Investment Research Intern.</span></li>
      <li><span class="exp-when">Jul – Sep 2024</span><span><strong>Tencent (Machine Learning Platform)</strong> — Research Intern. MCTS-based reasoning for Olympiad-style tasks.</span></li>
    </ul>
  </section>

  <section class="block">
    <h2 class="section">Blogs</h2>
    {posts.length > 0 ? (
      <ul class="post-list">
        {posts.map((post) => (
          <li>
            <span class="post-when"><time datetime={post.data.date.toISOString()}>{formatDate(post.data.date)}</time></span>
            <span>
              <div class="post-title"><a href={`/blog/${post.id}/`}>{post.data.title}</a></div>
              <p class="post-summary">{post.data.summary}</p>
            </span>
          </li>
        ))}
      </ul>
    ) : (
      <p class="note">Posts will appear here as they are published.</p>
    )}
    <p style="margin-top:14px"><a href="/blog/">All posts →</a></p>
  </section>

  <section class="block">
    <h2 class="section">Miscs</h2>
    <ul>
      <li>Board member of <a href="https://cphos.cn" target="_blank" rel="noopener noreferrer">CPHOS</a>, a nonprofit community of physics-competition alumni that organizes free competitions and academic seminars for high-school students (2023 – present).</li>
    </ul>
  </section>
</BaseLayout>
