---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { projects, type Project } from '../../data/projects';

export function getStaticPaths() {
  return projects.map((project) => ({ params: { slug: project.slug }, props: { project } }));
}

const { project } = Astro.props as { project: Project };
---
<BaseLayout title={project.title} description={project.description}>
  <section class="block">
    <a class="backlink" href="/projects/">← All projects</a>
    <div class="page-title">{project.title}</div>
    <p class="page-sub">{project.tagline}</p>
    <ul class="exp">
      <li><span class="exp-when">Type</span><span>{project.category}</span></li>
      <li><span class="exp-when">Period</span><span>{project.period}</span></li>
      <li><span class="exp-when">Affiliation</span><span>{project.affiliation}</span></li>
      <li><span class="exp-when">Status</span><span>{project.ongoing ? 'Ongoing' : 'Completed'}</span></li>
    </ul>
  </section>

  <section class="block">
    <h2 class="section">Overview</h2>
    <p>{project.description}</p>
    <ul>{project.details.map((item) => <li>{item}</li>)}</ul>
    <div class="tags" style="margin-top:12px">{project.tags.map((tag) => <span class="tag">{tag}</span>)}</div>
  </section>

  <p class="note">
    This public overview does not include private code, unpublished measurements, or confidential details from industry
    collaborations.
  </p>
</BaseLayout>
