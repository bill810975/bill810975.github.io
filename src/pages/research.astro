---
import BaseLayout from '../layouts/BaseLayout.astro';
import ProjectRow from '../components/ProjectRow.astro';
import { projects } from '../data/projects';

const researchProjects = projects.filter((project) => project.category === 'Research');
---
<BaseLayout
  title="Research"
  description="Research directions of Muheng Li: AI accelerator architecture, LLM inference and serving, GPU kernels, and agent systems."
>
  <section class="block">
    <h2 class="section">Research</h2>
    <p>
      My research spans machine learning systems, computer architecture, and the internal science of how language models develop,
      since that understanding shapes the infrastructure we build around them. I am also interested in agent systems for
      machine learning systems and computer architecture, especially agents that support their co-design.
    </p>
  </section>

  <section class="block">
    <h2 class="section">Research Interests</h2>
    <ul>
      <li>
        <strong>Machine learning systems</strong>
        <ul>
          <li>Workload, compiler, and computer architecture co-design</li>
          <li>Kernel generation</li>
        </ul>
      </li>
      <li>
        <strong>Computer architecture</strong>
        <ul><li>3D-stacked DRAM AI accelerator</li></ul>
      </li>
      <li>
        <strong>Agent systems for machine learning systems and computer architecture co-design</strong>
        <ul>
          <li>Concurrency scaling of agent systems</li>
          <li>Agent build agent</li>
          <li>Agent for machine learning systems and computer architecture co-design</li>
        </ul>
      </li>
    </ul>
  </section>

  <section class="block">
    <h2 class="section">Research Projects</h2>
    <div class="proj-list">{researchProjects.map((project) => <ProjectRow project={project} />)}</div>
  </section>

  <p class="note">
    Unpublished measurements, confidential details, and code from industry collaborations are intentionally omitted.
  </p>
</BaseLayout>
