---
import BaseLayout from '../layouts/BaseLayout.astro';
import ProjectRow from '../components/ProjectRow.astro';
import { currentProjects } from '../data/projects';
import { getCollection } from 'astro:content';

const homepageProjects = currentProjects;
const posts = (await getCollection('blog', ({ data }) => !data.draft))
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime())
  .slice(0, 3);
const formatDate = (date: Date) =>
  date.toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric', timeZone: 'UTC' });
---
<BaseLayout>
  <section class="block">
    <h2 class="section">About Me</h2>
    <p>
      I am a senior undergraduate in the <a href="https://iiis.tsinghua.edu.cn/en/" target="_blank" rel="noopener noreferrer">Yao Class</a>
      (Institute for Interdisciplinary Information Sciences) at
      <a href="https://www.tsinghua.edu.cn/en/" target="_blank" rel="noopener noreferrer">Tsinghua University</a>,
      pursuing a B.S. in Computer Science and Technology, and an incoming PhD student at <a href="https://group.iiis.tsinghua.edu.cn/~maks/" target="_blank" rel="noopener noreferrer">ARChip Lab</a>.
    </p>
    <p>
      My research spans machine learning systems, computer architecture, and the internal science of how language models develop,
      since that understanding shapes the infrastructure we build around them. I am also interested in agent systems for
      machine learning systems and computer architecture, especially agents that support their co-design.
    </p>
    <p>
      I have spent time as a research intern at the <a href="https://catalyst.cs.cmu.edu/" target="_blank" rel="noopener noreferrer">Catalyst Lab</a>,
      Carnegie Mellon University, where I was advised by <a href="https://scholar.google.com/citations?user=0IWLFR4AAAAJ&amp;hl=en" target="_blank" rel="noopener noreferrer">Zhihao Jia</a> on persistent GPU kernels and megakernel generation, at
      <a href="https://www.tencent.com/en-us/" target="_blank" rel="noopener noreferrer">Tencent</a>
      on draft models for speculative decoding and on search-based reasoning for Olympiad-style mathematics and physics,
      and at <a href="https://group.iiis.tsinghua.edu.cn/~maks/" target="_blank" rel="noopener noreferrer">ARChip Lab</a>, Tsinghua University, on 3D-stacked accelerator design.
    </p>
  </section>

  <section class="block">
    <h2 class="section">Research Interests</h2>
    <ul>
      <li>
        <strong>Machine learning systems</strong>
        <ul>
          <li>Workload, compiler, and computer architecture co-design</li>
          <li>Kernel generation</li>
        </ul>
      </li>
      <li>
        <strong>Computer architecture</strong>
        <ul><li>3D-stacked DRAM AI accelerator</li></ul>
      </li>
      <li>
        <strong>Agent systems for machine learning systems and computer architecture co-design</strong>
        <ul>
          <li>Concurrency scaling of agent systems</li>
          <li>Agent Build Agent</li>
          <li>Agent for machine learning systems and computer architecture co-design</li>
        </ul>
      </li>
    </ul>
  </section>

  <section class="block">
    <h2 class="section">Education</h2>
    <ul>
      <li>
        <strong>B.S. in Computer Science and Technology</strong>, Tsinghua University, 2023–2027 (expected).
        Institute for Interdisciplinary Information Sciences (Yao Class). GPA 3.8 / 4.0.
      </li>
    </ul>
  </section>

  <section class="block">
    <h2 class="section">Projects</h2>
    <div class="proj-list">{homepageProjects.map((project) => <ProjectRow project={project} />)}</div>
  </section>

  <section class="block">
    <h2 class="section">Experience</h2>
    <h3>Academic</h3>
    <ul class="exp">
      <li><span class="exp-when">Feb 2025 – Present</span><span><strong><a href="https://group.iiis.tsinghua.edu.cn/~maks/" target="_blank" rel="noopener noreferrer">ARChip Lab</a>, Tsinghua University</strong> — Research Assistant -&gt; Incoming PhD.</span></li>
      <li><span class="exp-when">Feb 2026 – Jul 2026</span><span><strong><a href="https://catalyst.cs.cmu.edu/" target="_blank" rel="noopener noreferrer">Catalyst Lab</a>, Carnegie Mellon University</strong> — Research Intern, advised by <a href="https://scholar.google.com/citations?user=0IWLFR4AAAAJ&amp;hl=en" target="_blank" rel="noopener noreferrer">Zhihao Jia</a>.</span></li>
    </ul>
    <h3>Industry</h3>
    <ul class="exp">
      <li><span class="exp-when">Jan 2026 – Present</span><span><strong>Tencent (WELM)</strong> — Research Intern.</span></li>
      <li><span class="exp-when">Sep 2024 – Feb 2025</span><span><strong>ZhenFund</strong> — Investment Research Intern.</span></li>
      <li><span class="exp-when">Jul – Sep 2024</span><span><strong>Tencent (Hunyuan)</strong> — Research Intern.</span></li>
    </ul>
  </section>

  <section class="block">
    <h2 class="section">Blogs</h2>
    {posts.length > 0 ? (
      <ul class="post-list">
        {posts.map((post) => (
          <li>
            <span class="post-when"><time datetime={post.data.date.toISOString()}>{formatDate(post.data.date)}</time></span>
            <span>
              <div class="post-title"><a href={`/blog/${post.id}/`}>{post.data.title}</a></div>
              <p class="post-summary">{post.data.summary}</p>
            </span>
          </li>
        ))}
      </ul>
    ) : (
      <p class="note">Posts will appear here as they are published.</p>
    )}
    <p style="margin-top:14px"><a href="/blog/">All posts →</a></p>
  </section>

  <section class="block">
    <h2 class="section">News</h2>
  </section>

  <section class="block">
    <h2 class="section">Miscs</h2>
    <ul>
      <li>Board member of <a href="https://cphos.cn" target="_blank" rel="noopener noreferrer">CPHOS</a>, a nonprofit community of physics-competition alumni that organizes free competitions and academic seminars for high-school students (2023 – present).</li>
    </ul>
  </section>
</BaseLayout>
